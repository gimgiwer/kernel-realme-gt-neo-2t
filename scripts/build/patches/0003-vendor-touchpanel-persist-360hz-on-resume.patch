+void oplus_touch_set_high_frame_rate(int value)
+{
+    if (!g_tp || !g_tp->ts_ops || !g_tp->ts_ops->set_high_frame_rate)
+        return;
+    mutex_lock(&g_tp->mutex);
+    g_tp->ts_ops->set_high_frame_rate(g_tp->chip_data, value, 0);
+    g_tp->high_frame_value = value;
+    mutex_unlock(&g_tp->mutex);
+}
+EXPORT_SYMBOL(oplus_touch_set_high_frame_rate);
