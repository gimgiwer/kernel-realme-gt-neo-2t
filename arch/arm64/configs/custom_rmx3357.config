# Custom kernel config overlay for Realme GT Neo 2T (RMX3357 / MT6893)
# Apply on top of k6893v1_64_k419_defconfig via merge_config.sh

# --- KernelSU-Next + SUSFS v1.5.5 ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# --- WireGuard (in-kernel, hardware crypto) ---
CONFIG_WIREGUARD=y

# --- TCP Congestion + Queue Disciplines ---
# CONFIG_TCP_CONG_BIC is not set
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_CUBIC=y
CONFIG_DEFAULT_TCP_CONG="cubic"
CONFIG_DEFAULT_NET_SCH="fq_codel"
CONFIG_NET_SCH_DEFAULT=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_IP_NF_TARGET_TTL=y

# --- File Systems & Storage ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_CIFS=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
# CONFIG_NFS_FS is not set
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_HFS_FS=y
CONFIG_HFSPLUS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_TMPFS_XATTR=y

# --- Device Mapper & Block Layer ---
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_INTEGRITY=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_DEV_NULL_BLK=m

# --- Hardware Crypto (ARM64 CE & AF_ALG) ---
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_CHACHA20_NEON=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_CRC32_ARM64_CE=y
CONFIG_CRYPTO_USER_API=m
CONFIG_CRYPTO_USER_API_AEAD=m
CONFIG_CRYPTO_USER_API_HASH=m

# --- Memory Management & IPC (12 GB RAM Tuning) ---
CONFIG_CRYPTO_LZ4=y
CONFIG_KSM=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
# CONFIG_USERFAULTFD is not set
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_BINFMT_MISC=y

# --- CPU Scheduling & Tuning ---
# CONFIG_SCHED_AUTOGROUP is not set
CONFIG_HZ_360=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_PSI=y

# --- USB Peripherals & Hardware Interfacing ---
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OPTION=m
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y

# --- Audio & Video Subsystems ---
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_ALOOP=m
CONFIG_SND_RAWMIDI=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# --- Automotive & Radio (CAN / SDR) ---
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_VCAN=m
CONFIG_CAN_SLCAN=m
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_DVB_CORE=y
CONFIG_I2C_MUX=y
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m

# --- USB Gadget (ConfigFS) ---
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_ACM=y
# CONFIG_USB_CONFIGFS_RNDIS is not set
# CONFIG_USB_F_RNDIS is not set
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_UVC=y

# --- USB Ethernet Adapters ---
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDCETHER=y

# --- Container & Proxy Networking ---
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_TEE=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_NET_SCH_NETEM=y
CONFIG_6LOWPAN=y
CONFIG_BT_6LOWPAN=m
CONFIG_BT_HCIBTUSB=m
CONFIG_NET_IPGRE=y
CONFIG_NET_IPGRE_DEMUX=y

# --- Network audit, wardriving & packet injection ---
# CONFIG_CFG80211_WEXT is not set
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
# CONFIG_MAC80211_MESH is not set
CONFIG_MAC80211_LEDS=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_CARL9170_LEDS=y
CONFIG_CARL9170_WPC=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RTL8187=m
CONFIG_RTL8187_LEDS=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_USB_NET_RNDIS_WLAN=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_CMP=y
CONFIG_NET_EMATCH_NBYTE=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_EMATCH_META=y
CONFIG_NET_EMATCH_TEXT=y
CONFIG_NET_CLS_FLOWER=m
CONFIG_NET_ACT_CSUM=m
CONFIG_NET_ACT_SKBMOD=m
CONFIG_NET_ACT_PEDIT=m
CONFIG_NET_ACT_CONNMARK=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_NF_TARGET_SYNPROXY=m
CONFIG_IP6_NF_TARGET_SYNPROXY=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_PACKET_DIAG=m
CONFIG_UNIX_DIAG=m

# --- Tracing, Debugging & Forensics ---
CONFIG_KALLSYMS_ALL=y
CONFIG_PROC_CHILDREN=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_BPF_SYSCALL=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_BPF=y

# --- disabled: ABI pinning, flash endurance, stability ---
# Zero swap on flash:
# CONFIG_ZRAM_WRITEBACK is not set
# Wi-Fi net_device ABI protection (dev_addr offset strictly 752 bytes):
# CONFIG_IPVLAN is not set
# CONFIG_NET_L3_MASTER_DEV is not set
# MediaTek driver safety:
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_F2FS_FS_COMPRESSION is not set
CONFIG_MODULE_SIG=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# Stability & Bootloop Prevention:
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DEVTMPFS is not set
# CONFIG_PSTORE_RAM is not set
# CONFIG_SECURITY_YAMA is not set

# Procfs config:
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

